# Optional. Postgres connection string; prediction history is disabled when empty
DATABASE_URL=

# Optional. Folder containing model.joblib (falls back to api/artifacts, then ml/artifacts)
MODEL_DIR=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional. Regex for extra allowed origins (e.g. Vercel preview URLs)
CORS_ORIGIN_REGEX=
